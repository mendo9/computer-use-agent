# Mode
COMPUTER_MODE=lume       # remote | lume

# LLM
OPENAI_MODEL=omniparser+openai/gpt-4o
OPENAI_API_KEY=sk-...

# Self-hosted VM reverse proxy (REMOTE mode)
VM_PROXY_URL=https://cua-vm-01.corp.local
PROXY_API_KEY=super-secret     # or leave empty if mTLS only
# mTLS (optional)
CLIENT_CERT_PATH=
CLIENT_KEY_PATH=
CA_CERT_PATH=

# Lume VM (macOS virtualization)
# VM automatically created and managed via src/backends/lume_vm.py
# Uses macos-sequoia-cua_15.4 image with computer server on port 8000

# Azure Service Bus
SB_CONNECTION_STRING=Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...
SB_QUEUE_NAME=work-items

# Optional BYO vision (PaddleOCR/OpenCV) instead of OmniParser grounding
USE_LOCAL_VISION=false

# Trajectory and logging
TRAJECTORY_DIR=./trajectories
LOG_LEVEL=INFO
