{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run TextEdit Demo",
            "type": "debugpy",
            "request": "launch",
            "module": "src.tasks.demo_macos_textedit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "preLaunchTask": "install-local-run-deps",
        },
        {
            "name": "Run Agent TextEdit Demo",
            "type": "debugpy",
            "request": "launch",
            "module": "src.tasks.demo_macos_agent_textedit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "preLaunchTask": "install-local-run-deps",
        }
    ]
}
