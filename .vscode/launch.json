{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Element Finder",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/debug/debug_element_finder.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": ["${input:screenshotPath}", "${input:elementsToTest}"]
        }
    ],
    "inputs": [
        {
            "id": "screenshotPath",
            "description": "Path to screenshot file",
            "default": "trajectories/data/osh_heart_header_screenshot.png",
            "type": "pickString",
            "options": [
                "trajectories/data/osh_heart_header_screenshot.png",
            ]
        },
        {
            "id": "elementsToTest",
            "description": "Elements to test (space-separated)",
            "options": [
                "test",
            ],
            "default": "test",
            "type": "pickString"
        }
    ]
}
